{
  "manifest_version": 3,
  "name": "OpenLST",
  "version": "0.1.0",
  "description": "Læs op og diktér på hjemmesider. Alt behandles lokalt af OpenLST på din computer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OpenLST – vis/skjul værktøjslinjen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Læs markeret tekst op"
    },
    "toggle-toolbar": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Vis/skjul OpenLST-værktøjslinjen"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/sentences.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "http://localhost:8765/*",
        "http://127.0.0.1:8765/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
